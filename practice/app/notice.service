[Unit]
Description=Notice app (社内のお知らせサイトのアプリ)
After=network-online.target
Wants=network-online.target

[Service]
User=notice
WorkingDirectory=/opt/notice
Environment=NOTICE_DATA=/srv/notice/data/notices.json
ExecStart=/usr/bin/python3 /opt/notice/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
